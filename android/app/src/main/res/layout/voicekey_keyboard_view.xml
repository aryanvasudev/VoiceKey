<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_keyboard_panel"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Top status bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="@string/status_idle"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btn_switch_keyboard_top"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/switch_keyboard"
            android:src="@drawable/ic_keyboard_switch" />

    </RelativeLayout>

    <!-- Waveform visualization -->
    <com.voicekey.app.ui.WaveformView
        android:id="@+id/waveform_view"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp" />

    <!-- Center Dictation Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_mic_button"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/subtype_voice"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Keyboard switch button -->
        <ImageButton
            android:id="@+id/btn_switch_keyboard"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_key"
            android:src="@drawable/ic_keyboard_switch"
            android:contentDescription="@string/switch_keyboard" />

        <!-- Space bar -->
        <Button
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_key"
            android:text="@string/btn_space"
            android:textAllCaps="false"
            android:textColor="#E4E4E7"
            android:textSize="13sp" />

        <!-- Backspace button -->
        <ImageButton
            android:id="@+id/btn_backspace"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_key"
            android:src="@drawable/ic_backspace"
            android:contentDescription="@string/btn_backspace" />

        <!-- Enter / Submit button -->
        <ImageButton
            android:id="@+id/btn_enter"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_action_key"
            android:src="@drawable/ic_enter"
            android:contentDescription="@string/btn_enter" />

    </LinearLayout>

</LinearLayout>
