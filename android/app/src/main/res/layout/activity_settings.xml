<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#18181B">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="#FFFFFF"
            app:subtitle="Offline Speech-to-Text IME Settings"
            app:subtitleTextColor="#A1A1AA" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- System IME Setup Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#27272A"
                app:cardCornerRadius="12dp"
                app:strokeColor="#3F3F46"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keyboard Activation"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Enable VoiceKey in system settings to use on-device voice typing in any app."
                        android:textColor="#A1A1AA"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btn_enable_ime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#4F46E5"
                            android:text="Enable IME"
                            android:textSize="12sp"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/btn_select_ime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="#3F3F46"
                            android:text="Select IME"
                            android:textSize="12sp"
                            android:textAllCaps="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: GGML Whisper Models -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Whisper Models"
                android:textColor="#818CF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Model Card: Tiny.en -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_model_tiny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#18181B"
                app:cardCornerRadius="10dp"
                app:strokeColor="#27272A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txt_tiny_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Whisper Tiny.en (77 MB)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_tiny_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Not Downloaded"
                            android:textColor="#71717A"
                            android:textSize="12sp" />

                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Fastest inference (~50ms). Lowest battery and memory consumption."
                        android:textColor="#A1A1AA"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/progress_tiny"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_action_tiny"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#4F46E5"
                            android:text="Download"
                            android:textSize="11sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textAllCaps="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Model Card: Base.en -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_model_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#18181B"
                app:cardCornerRadius="10dp"
                app:strokeColor="#27272A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txt_base_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Whisper Base.en (148 MB)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_base_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Not Downloaded"
                            android:textColor="#71717A"
                            android:textSize="12sp" />

                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Recommended standard model (~120ms). High accuracy for daily voice dictation."
                        android:textColor="#A1A1AA"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/progress_base"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_action_base"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#4F46E5"
                            android:text="Download"
                            android:textSize="11sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textAllCaps="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Vocabulary & Dictionary -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Vocabulary Prompt"
                android:textColor="#818CF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="#18181B"
                app:boxStrokeColor="#4F46E5"
                app:hintTextColor="#818CF8"
                android:textColorHint="#71717A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_custom_vocabulary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Kubernetes, Rust, GraphQL, Docker, VoiceKey"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:lines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Section 3: Audio & Typing Behavior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Typing & Audio Preferences"
                android:textColor="#818CF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Haptic Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_haptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Haptic Click Feedback"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- Spoken Punctuation Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_spoken_punctuation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoken Punctuation (e.g. 'comma' -> ',')"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- Auto Normalize Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_auto_normalize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Normalize Whitespace & Capitalization"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
