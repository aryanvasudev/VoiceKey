{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceKey",
  "version": "0.2.0",
  "identifier": "com.voicekey.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "VoiceKey Overlay",
        "label": "overlay",
        "url": "index.html#overlay",
        "width": 340,
        "height": 90,
        "resizable": false,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "title": "VoiceKey Settings",
        "label": "settings",
        "url": "index.html#settings",
        "width": 720,
        "height": 600,
        "resizable": false,
        "visible": false,
        "transparent": false,
        "decorations": true
      }
    ]
  },
  "plugins": {
    "autostart": {},
    "single-instance": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
